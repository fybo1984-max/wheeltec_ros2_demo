<?xml version="1.0"?>
<package format="3">
  <name>semantic_costmap_plugin</name>
  <version>0.1.0</version>
  <description>
    ROS 2 Humble Nav2 costmap layer for fuzzy semantic-zone guidance.
  </description>
  <maintainer email="fybo1984-max@users.noreply.github.com">WHEELTEC innovation workspace</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_costmap_2d</depend>
  <depend>nav2_map_server</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>nav2_util</test_depend>
  <test_depend>tf2_ros</test_depend>

  <export>
    <costmap_2d plugin="${prefix}/custom_layer.xml"/>
    <build_type>ament_cmake</build_type>
  </export>
</package>
